# Rereflect Environment Variables
# Copy this file to .env and update values as needed

# Admin user (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# JWT Secret - REQUIRED. The app refuses to start without it.
# It used to fall back to a value published in this repo, which meant
# anyone could forge an auth token on a default install.
# Generate one:  openssl rand -hex 32
JWT_SECRET=

# Database (only needed for local non-Docker development)
# DATABASE_URL=postgresql:///customer_feedback_saas

# Redis (only needed for local non-Docker development)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# CORS origins (comma-separated, for production)
# CORS_ORIGINS=https://your-frontend-domain.com

# Integrations (optional)
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# INTERCOM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/intercom/oauth/callback

# --- Inbound webhook signing secrets -----------------------------------------
# Each inbound webhook endpoint authenticates deliveries with an HMAC signature.
# Set the secret for any source you actually use.
#
# INTERCOM_CLIENT_SECRET (above) doubles as the Intercom webhook HMAC key.
#   Unset  -> every delivery is REJECTED (401). Fails closed.
#
# SLACK_SIGNING_SECRET — from your Slack app's Basic Information page.
#   Unset  -> every Slack webhook delivery is REJECTED (401). Fails closed.
#   Set it if you use the Slack source.
# SLACK_SIGNING_SECRET=
#
# RESEND_INBOUND_WEBHOOK_SECRET — from your Resend inbound webhook settings.
#   Unset  -> every inbound email webhook delivery is REJECTED (401). Fails closed.
# RESEND_INBOUND_WEBHOOK_SECRET=
